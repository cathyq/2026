# Databricks Agent App Environment Variables
# Copy this file to .env and fill in your values

# Lakebase Configuration
LAKEBASE_INSTANCE_NAME=your-lakebase-instance
LAKEBASE_DATABASE_NAME=your-database
LAKEBASE_CATALOG_NAME=your-catalog

# Database Connection
DATABRICKS_DATABASE_PORT=5432
DEFAULT_POSTGRES_SCHEMA=public

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_INTERVAL=3600

# Databricks Configuration (for local development)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-token

# Agent Configuration
DATABRICKS_MODEL_ENDPOINT=databricks-claude-3-5-sonnet
AGENT_SYSTEM_PROMPT=You are a helpful AI assistant with long-term memory capabilities.
